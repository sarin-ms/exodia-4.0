{
  "name": "exodia-4.0",
  "version": "0.1.0",
  "private": true,
  "author": {
    "name": "Sarin MS"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "api:dev": "wrangler dev --config worker/wrangler.jsonc",
    "api:typecheck": "tsc --project worker/tsconfig.json",
    "api:test": "bun test worker/tests",
    "api:deploy": "wrangler deploy --config worker/wrangler.jsonc",
    "api:types": "wrangler types worker/worker-configuration.d.ts --config worker/wrangler.jsonc --env-interface RegistrationWorkerBindings --include-runtime=false --strict-vars=false",
    "db:create": "wrangler d1 create exodia-registration --config worker/wrangler.jsonc",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --config worker/wrangler.jsonc",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote --config worker/wrangler.jsonc"
  },
  "dependencies": {
    "@fontsource-variable/rubik": "5.3.0",
    "gsap": "^3.15.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261025.1",
    "@types/bun": "1.4.4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "miniflare": "4.20260708.1",
    "typescript": "^5",
    "wrangler": "4.110.0"
  },
  "overrides": {
    "sharp": "0.35.5",
    "undici": "7.30.1"
  },
  "packageManager": "bun@1.4.3",
  "engines": {
    "node": "22.x"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
